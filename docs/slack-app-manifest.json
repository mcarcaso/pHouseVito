{
  "display_information": {
    "name": "Vito",
    "description": "Your personal Vito agent in Slack",
    "background_color": "#252b42"
  },
  "features": {
    "bot_user": { "display_name": "Vito", "always_online": true },
    "app_home": { "messages_tab_enabled": true, "messages_tab_read_only_enabled": false },
    "slash_commands": [
      {
        "command": "/vito",
        "description": "Control Vito in this conversation",
        "usage_hint": "help | stop | status | new | compact | model [name] | session [id] | login [provider] | restart",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "commands",
        "files:read",
        "files:write",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "mpim:history",
        "mpim:read",
        "reactions:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "interactivity": { "is_enabled": true },
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim"
      ]
    },
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
